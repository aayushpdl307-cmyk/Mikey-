# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_URL=mongodb://localhost:27017/typing-game
DB_TYPE=mongodb
# For SQLite: DB_TYPE=sqlite
# DB_PATH=./data/game.db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d

# Game Configuration
BASE_COIN_REWARD=10
COIN_MULTIPLIER=1.5
XP_PER_GAME=50
LEVEL_UP_XP=1000

# Shop Configuration
INITIAL_COINS=100
DAILY_REWARD=50

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGIN=http://localhost:3000,http://localhost:5000
